PRODUCT_BUNDLE_IDENTIFIER = at.sovi.companion
PRODUCT_NAME = Sovi
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 3
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1,2
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Sovi
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.healthcare-fitness
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
LOCALIZATION_PREFERS_STRING_CATALOGS = NO
CODE_SIGN_STYLE = Automatic
#include? "Local.xcconfig"
INFOPLIST_KEY_NSMicrophoneUsageDescription = Sovi nutzt das Mikrofon nur auf deinen Wunsch für lokale Spracheingabe. Es wird kein Audio gespeichert.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Gesprochene Eingaben werden nur bei verfügbarer Erkennung auf diesem Gerät in bearbeitbaren Text umgewandelt.
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Sovi nutzt deinen Standort nur auf deinen Wunsch für die Suche nach Anlaufstellen. Er geht an den Sovi-Server, nicht an OpenAI.
